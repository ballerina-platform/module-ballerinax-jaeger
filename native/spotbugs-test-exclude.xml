<FindBugsFilter>
    <!-- Test classes don't need to follow all production code rules -->
    <Match>
        <Class name="~.*Test"/>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>

    <!-- Test fields initialized by TestNG setup methods -->
    <Match>
        <Class name="~.*Test"/>
        <Bug pattern="UWF_FIELD_NOT_INITIALIZED_IN_CONSTRUCTOR"/>
    </Match>

    <!-- Mock objects and test utilities can expose internal representations -->
    <Match>
        <Class name="~.*Test"/>
        <Bug pattern="MS_EXPOSE_REP"/>
    </Match>

    <!-- withTraceLogCapture's local Logger.getLogger(...) reference is a false
         positive: JaegerTraceLogger holds that same named logger in its own
         "private static final Logger traceLogger" field for the JVM's whole
         lifetime, so it can't actually be weakly-collected between the
         addHandler/removeHandler calls in this method. -->
    <Match>
        <Class name="io.ballerina.observe.trace.jaeger.JaegerExporterTest"/>
        <Method name="withTraceLogCapture"/>
        <Bug pattern="LG_LOST_LOGGER_DUE_TO_WEAK_REFERENCE"/>
    </Match>
</FindBugsFilter>

